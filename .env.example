# Configuración de VITA+ en el servidor (docker-compose.yml).
#
# En el servidor: copia este archivo como ".env" (cp .env.example .env) y
# llena los valores. El archivo .env NO se sube a git.

# Dirección pública de la página, sin https://.
# Sin dominio propio se usa la IP pública con sslip.io, cambiando los puntos
# por guiones: IP 3.90.12.45  ->  3-90-12-45.sslip.io
DOMINIO=

# Contraseña de la base de datos de Supabase
DB_PASSWORD=

# Secreto con el que se firman las sesiones (JWT). Mínimo 32 caracteres.
# Generar uno nuevo con:  openssl rand -base64 48
JWT_SECRET=

# Clave de Hunter (verificación de correos)
HUNTER_API_KEY=

# Clave de TextBee (envío de SMS)
TEXTBEE_API_KEY=
